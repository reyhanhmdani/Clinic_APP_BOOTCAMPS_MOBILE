// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMERS
}

enum Gender {
  MALE
  FEMALE
}

enum VisitStatus {
  WAITING
  IN_KONSULTASI
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  PAID
  UNPAID
  CANCELLED
}

enum PaymentMethod {
  QRIS
  TRANSFER
  CARD
  CASH
}

model User {
  id        Int      @id @default(autoincrement())
  username  String?  @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("users")
}

model Patient {
  id        Int      @id @default(autoincrement())
  noRm      String   @unique @map("no_rm") @db.VarChar(255)
  name      String   @db.VarChar(255)
  gender    Gender
  age       Int
  phone     String?  @db.VarChar(255)
  address   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  visits Visit[]

  @@map("patients")
}

model Doctor {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  spesialis String   @db.VarChar(255)
  phone     String?  @db.VarChar(255)
  fee       Decimal  @default(50000) @db.Decimal(12, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  visits Visit[]

  @@map("doctors")
}

model Visit {
  id          Int         @id @default(autoincrement())
  patientId   Int         @map("patient_id")
  doctorId    Int         @map("doctor_id")
  queueNumber Int         @map("queue_number")
  visitDate   DateTime    @map("visit_date")
  status      VisitStatus @default(WAITING)
  checkInTime DateTime?   @map("check_in_time")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at")

  //relasi
  patient      Patient       @relation(fields: [patientId], references: [id])
  doctor       Doctor        @relation(fields: [doctorId], references: [id])
  consultation Consultation?
  invoice      Invoice?

  @@map("visits")
}

model Consultation {
  id              Int      @id @default(autoincrement())
  visitId         Int      @unique @map("visit_id")
  complaint       String
  diagnosis       String
  notes           String?
  consultationFee Decimal  @map("consultation_fee") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  visit                 Visit                  @relation(fields: [visitId], references: [id], onDelete: Cascade)
  consultationMedicines ConsultationMedicine[]

  @@map("consultations")
}

model Medicine {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(255)
  name      String   @db.VarChar(255)
  price     Decimal  @db.Decimal(12, 2)
  stock     Int
  unit      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  consultationMedicines ConsultationMedicine[]

  @@map("medicines")
}

model ConsultationMedicine {
  id             Int      @id @default(autoincrement())
  consultationId Int      @map("consultation_id")
  medicineId     Int      @map("medicine_ud")
  qty            Int
  price          Decimal  @db.Decimal(12, 2)
  subTotal       Decimal  @map("sub_total") @db.Decimal(12, 2)
  instructions   String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  medicine     Medicine     @relation(fields: [medicineId], references: [id])

  @@map("consultation_medicine")
}

model Invoice {
  id                   Int           @id @default(autoincrement())
  visitId              Int           @unique @map("visit_id")
  invoiceNo            String        @map("invoice_no") @db.VarChar(255)
  totalConsultationFee Decimal       @map("total_consultation_fee") @db.Decimal(12, 2)
  totalMedicineFee     Decimal       @map("total_medicine_fee") @db.Decimal(12, 2)
  totalAmount          Decimal       @map("total_amount") @db.Decimal(12, 2)
  status               InvoiceStatus @default(UNPAID)
  paymentMethod        PaymentMethod @default(CASH) @map("payment_method")
  paidAt               DateTime?     @map("paid_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at")

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("invoice")
}
